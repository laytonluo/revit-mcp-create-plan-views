<Window
    x:Class="AddTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新增梁類型"
    Width="360" Height="280"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 按鈕列 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="建立" Width="80" Height="28"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="28" Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>

        <!-- 表單 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 複製自 -->
                <RowDefinition Height="Auto"/>
                <!-- 建議名稱 -->
                <RowDefinition Height="Auto"/>
                <!-- 名稱 -->
                <RowDefinition Height="Auto"/>
                <!-- 寬度 b -->
                <RowDefinition Height="Auto"/>
                <!-- 深度 h -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 複製自 -->
            <Label Grid.Row="0" Grid.Column="0" Content="複製自："
                   VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbSourceType" Grid.Row="0" Grid.Column="1"
                      Height="26" Margin="0,4"
                      ToolTip="從此族群類型複製，再修改尺寸參數"/>

            <!-- 建議名稱（唯讀提示） -->
            <Label Grid.Row="1" Grid.Column="0" Content="建議名稱："
                   VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSuggestedName" Grid.Row="1" Grid.Column="1"
                     Height="26" Margin="0,4" IsReadOnly="True"
                     Foreground="Gray" VerticalContentAlignment="Center"/>

            <!-- 名稱（可手動修改） -->
            <Label Grid.Row="2" Grid.Column="0" Content="名稱："
                   VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTypeName" Grid.Row="2" Grid.Column="1"
                     Height="26" Margin="0,4" VerticalContentAlignment="Center"/>

            <!-- 寬度 b (cm) -->
            <Label Grid.Row="3" Grid.Column="0" Content="寬度 b (cm)："
                   VerticalAlignment="Center"/>
            <TextBox x:Name="TxtWidthCm" Grid.Row="3" Grid.Column="1"
                     Height="26" Margin="0,4" VerticalContentAlignment="Center"/>

            <!-- 深度 h (cm) -->
            <Label Grid.Row="4" Grid.Column="0" Content="深度 h (cm)："
                   VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDepthCm" Grid.Row="4" Grid.Column="1"
                     Height="26" Margin="0,4" VerticalContentAlignment="Center"/>

        </Grid>

    </DockPanel>
</Window>
